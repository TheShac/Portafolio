---
import type { Project } from "../data/projects";
import { TECH } from "../data/techIcons";
import LinkButton from "./LinkButton.astro";
import T from "./T.astro";
import IconCode from "./icons/IconCode.astro";
import IconExternalLink from "./icons/IconExternalLink.astro";

type Props = Project;

const { title, description, image, tags, repoUrl, previewUrl } = Astro.props;
---

<article class="grid gap-5 sm:grid-cols-[3fr_2fr] sm:items-start sm:gap-8">
	<img
		src={image}
		alt={`Vista previa de ${title}`}
		data-i18n-attr="alt"
		data-i18n-es={`Vista previa de ${title}`}
		data-i18n-en={`Preview of ${title}`}
		width="640"
		height="360"
		class="aspect-video w-full rounded-lg border border-border object-cover"
		loading="lazy"
	/>

	<div>
		<h3 class="text-xl font-semibold">{title}</h3>

		<ul class="mt-2 flex flex-wrap gap-2">
			{
				tags.map((key) => {
					const tech = TECH[key];
					return (
						<li>
							<span
								class={`flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium ${tech.class}`}
							>
								<tech.icon class="size-3.5" />
								{tech.name}
							</span>
						</li>
					);
				})
			}
		</ul>

		<p class="mt-3 text-text-muted">
			<T es={description.es} en={description.en} />
		</p>

		<footer class="mt-4 flex flex-wrap items-center gap-3">
			{repoUrl && (
				<LinkButton href={repoUrl}>
					<IconCode class="size-4" />
					<T es="Código" en="Code" />
				</LinkButton>
			)}
			{previewUrl && (
				<LinkButton href={previewUrl}>
					<IconExternalLink class="size-4" />
					<T es="Ver proyecto" en="View project" />
				</LinkButton>
			)}
		</footer>
	</div>
</article>
