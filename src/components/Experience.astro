---
import { experience } from "../data/experience";
import SectionHeader from "./SectionHeader.astro";
import T from "./T.astro";
import IconBriefcase from "./icons/IconBriefcase.astro";
---

<section id="experiencia" class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
	<SectionHeader index="01" titleEs="Experiencia laboral" titleEn="Work experience">
		<IconBriefcase slot="icon" class="size-4.5" />
	</SectionHeader>

	<ol class="flex flex-col gap-9">
		{
			experience.map((item) => (
				<li class="relative grid gap-1.5 border-l border-border pl-6 sm:grid-cols-[15rem_1fr] sm:gap-8 sm:border-l-0 sm:pl-0">
					<span class="absolute top-1 left-0 size-2 -translate-x-1/2 rounded-full bg-accent sm:hidden" />

					<div>
						<p class="text-lg font-semibold text-accent">
							<T es={item.role.es} en={item.role.en} />
						</p>
						<p class="font-medium text-text">{item.company}</p>
						<p class="text-sm text-text-muted">
							<T es={item.period.es} en={item.period.en} />
						</p>
					</div>

					<div class="text-text-muted">
						<p>
							<T es={item.description.es} en={item.description.en} />
						</p>
						{item.link && (
							<a
								href={item.link.href}
								target="_blank"
								rel="noreferrer"
								class="mt-2 inline-block font-medium text-accent hover:underline"
							>
								<T es={item.link.label.es} en={item.link.label.en} />
							</a>
						)}
					</div>
				</li>
			))
		}
	</ol>
</section>
