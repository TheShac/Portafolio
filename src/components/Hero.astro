---
import { profile } from "../data/profile";
import { social } from "../data/social";
import LinkButton from "./LinkButton.astro";
import T from "./T.astro";
import IconGithub from "./icons/IconGithub.astro";
import IconLinkedin from "./icons/IconLinkedin.astro";
import IconMail from "./icons/IconMail.astro";
---

<section class="mx-auto max-w-4xl px-4 pt-14 pb-20 sm:px-6 sm:pt-20">
	<div class="hero-reveal flex items-center gap-5 sm:gap-6">
		<div class="photo-frame shrink-0">
			<img
				src={profile.photo}
				alt={`Foto de ${profile.name}`}
				data-i18n-attr="alt"
				data-i18n-es={`Foto de ${profile.name}`}
				data-i18n-en={`Photo of ${profile.name}`}
				width="96"
				height="96"
				class="size-20 rounded-full border border-border object-cover sm:size-24"
			/>
		</div>

		{
			profile.available && (
				<span class="inline-flex items-center gap-2 text-sm text-text-muted">
					<span class="relative flex size-2">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75" />
						<span class="relative inline-flex size-2 rounded-full bg-emerald-500" />
					</span>
					<T es="Disponible para trabajar" en="Available for work" />
				</span>
			)
		}
	</div>

	<div class="hero-reveal mt-8" style="animation-delay: 0.08s">
		<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
			<T es="Hey, soy" en="Hey, I'm" /> {profile.name}
		</h1>

		<p class="mt-4 max-w-prose text-text-muted">
			<T es={profile.experienceSummary.es} en={profile.experienceSummary.en} />{" "}
			<strong class="font-semibold text-accent">
				<T es={profile.role.es} en={profile.role.en} />
			</strong>{" "}
			<T es="de" en="based in" /> {profile.location}.{" "}
			<T es={profile.specialty.es} en={profile.specialty.en} />
		</p>

		<div class="mt-6 flex flex-wrap items-center gap-3">
			<LinkButton href={`mailto:${social.email}`} variant="solid">
				<IconMail class="size-4" />
				<T es="Contáctame" en="Contact me" />
			</LinkButton>
			<LinkButton href={social.linkedin}>
				<IconLinkedin class="size-4" />
				LinkedIn
			</LinkButton>
			<LinkButton href={social.github}>
				<IconGithub class="size-4" />
				GitHub
			</LinkButton>
		</div>
	</div>
</section>
