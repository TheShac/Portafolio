---
import { technologies } from "../data/technologies";
import { TECH } from "../data/techIcons";
import SectionHeader from "./SectionHeader.astro";
import IconTerminal from "./icons/IconTerminal.astro";
---

<section id="tecnologias" class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
	<SectionHeader index="02" title="Tecnologías">
		<IconTerminal slot="icon" class="size-4.5" />
	</SectionHeader>

	<ul class="flex flex-wrap gap-2">
		{
			technologies.map((key) => {
				const tech = TECH[key];
				return (
					<li>
						<span
							class={`flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium ${tech.class}`}
						>
							<tech.icon class="size-4" />
							{tech.name}
						</span>
					</li>
				);
			})
		}
	</ul>
</section>
