---
import IconLanguage from "./icons/IconLanguage.astro";
---

<button
	id="lang-toggle"
	type="button"
	class="flex h-8 shrink-0 items-center gap-1 rounded-md px-1.5 text-xs font-semibold text-text-muted transition-colors hover:text-accent"
	aria-label="Cambiar a inglés"
	data-i18n-attr="aria-label"
	data-i18n-es="Cambiar a inglés"
	data-i18n-en="Switch to Spanish"
>
	<IconLanguage class="size-4" />
	<span id="lang-toggle-label">ES</span>
</button>

<script>
	import { setLang, type Lang } from "../scripts/lang";

	const button = document.getElementById("lang-toggle");
	const label = document.getElementById("lang-toggle-label");

	function currentLang(): Lang {
		return document.documentElement.lang === "en" ? "en" : "es";
	}

	function syncLabel() {
		if (label) label.textContent = currentLang().toUpperCase();
	}

	button?.addEventListener("click", () => {
		setLang(currentLang() === "en" ? "es" : "en");
	});

	document.addEventListener("langchange", syncLabel);
	syncLabel();
</script>
