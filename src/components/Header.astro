---
import ThemeToggle from "./ThemeToggle.astro";
import IconMenu from "./icons/IconMenu.astro";
import IconClose from "./icons/IconClose.astro";
import { profile } from "../data/profile";

const links = [
	{ label: "Experiencia", href: "#experiencia" },
	{ label: "Proyectos", href: "#proyectos" },
	{ label: "Sobre mí", href: "#sobre-mi" },
	{ label: "Contacto", href: "#contacto" },
];

const initials = profile.name
	.split(" ")
	.filter(Boolean)
	.slice(0, 2)
	.map((word) => word[0]?.toUpperCase())
	.join("");
---

<header
	class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur-md"
>
	<div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3 sm:px-6">
		<a
			href="#"
			class="grid size-8 place-items-center rounded-md border border-border font-mono text-xs font-medium text-text transition-colors hover:border-accent hover:text-accent"
			aria-label="Volver al inicio"
		>
			{initials}
		</a>

		<nav class="hidden sm:block" aria-label="Secciones de la página">
			<ul class="flex items-center gap-6">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								data-nav-link
								data-target={link.href.slice(1)}
								class="nav-link border-b-2 border-transparent pb-0.5 text-sm font-medium text-text-muted transition-colors hover:text-text"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-1">
			<button
				id="mobile-menu-toggle"
				type="button"
				aria-label="Abrir menú de navegación"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="grid size-8 place-items-center rounded-md text-text-muted transition-colors hover:text-text sm:hidden"
			>
				<IconMenu class="size-5" id="mobile-menu-icon-open" />
				<IconClose class="hidden size-5" id="mobile-menu-icon-close" />
			</button>

			<ThemeToggle />
		</div>
	</div>

	<nav
		id="mobile-menu"
		aria-label="Secciones de la página"
		class="hidden flex-col border-t border-border bg-bg sm:hidden"
	>
		{
			links.map((link) => (
				<a
					href={link.href}
					data-nav-link
					data-target={link.href.slice(1)}
					class="nav-link border-b border-border px-4 py-3 text-sm font-medium text-text-muted last:border-b-0"
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.nav-link[data-active="true"] {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	/* El menú mobile solo necesita mostrarse en flex-col al abrirse;
	   controlamos el display aquí (solo por debajo de `sm`) para no
	   depender del orden en que Tailwind genera las utilidades
	   `hidden` y `flex`. */
	@media (max-width: 639.98px) {
		#mobile-menu:not(.hidden) {
			display: flex;
		}
	}
</style>

<script>
	const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
	const mobileMenu = document.getElementById("mobile-menu");
	const openIcon = document.getElementById("mobile-menu-icon-open");
	const closeIcon = document.getElementById("mobile-menu-icon-close");

	mobileMenuToggle?.addEventListener("click", () => {
		const isOpen = mobileMenu?.classList.toggle("hidden") === false;
		mobileMenuToggle.setAttribute("aria-expanded", String(isOpen));
		openIcon?.classList.toggle("hidden", isOpen);
		closeIcon?.classList.toggle("hidden", !isOpen);
	});

	mobileMenu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			mobileMenu.classList.add("hidden");
			mobileMenuToggle?.setAttribute("aria-expanded", "false");
			openIcon?.classList.remove("hidden");
			closeIcon?.classList.add("hidden");
		});
	});

	// Resalta el link del nav correspondiente a la sección visible.
	const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
	const sections = Array.from(navLinks)
		.map((link) => document.getElementById(link.dataset.target ?? ""))
		.filter((section): section is HTMLElement => section !== null);

	function setActive(id: string | null) {
		navLinks.forEach((link) => {
			const isActive = link.dataset.target === id;
			if (isActive) {
				link.setAttribute("data-active", "true");
				link.setAttribute("aria-current", "page");
			} else {
				link.removeAttribute("data-active");
				link.removeAttribute("aria-current");
			}
		});
	}

	// Scrollspy por posición: la sección activa es la última cuyo borde
	// superior ya cruzó la línea de activación (justo debajo del header).
	// A diferencia de un IntersectionObserver por ratio, esto no depende
	// de qué tan alta sea cada sección ni de la dirección del scroll —
	// con ratios, "Proyectos" (mucho más alta que el resto) casi nunca
	// ganaba la comparación al hacer scroll hacia arriba y se saltaba.
	const ACTIVATION_OFFSET = 110;

	function updateActiveSection() {
		const activationY = window.scrollY + ACTIVATION_OFFSET;
		const atBottom =
			window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

		let currentId: string | null = sections[0]?.id ?? null;
		for (const section of sections) {
			const sectionTop = section.getBoundingClientRect().top + window.scrollY;
			if (sectionTop <= activationY) {
				currentId = section.id;
			} else {
				break;
			}
		}

		if (atBottom && sections.length > 0) {
			currentId = sections[sections.length - 1].id;
		}

		setActive(currentId);
	}

	// El cálculo recorre solo 4-5 secciones y no vale la pena throttlear con
	// requestAnimationFrame: si el frame nunca llega a dispararse (pestaña en
	// segundo plano, etc.) un throttle basado en rAF puede quedar "pegado" y
	// dejar de actualizar el nav por completo.
	window.addEventListener("scroll", updateActiveSection, { passive: true });
	window.addEventListener("resize", updateActiveSection);
	updateActiveSection();
</script>
