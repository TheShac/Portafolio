---
import T from "./T.astro";

interface Props {
	/** Código de dos dígitos: la sección es un ítem real del índice de la página. */
	index: string;
	titleEs: string;
	titleEn: string;
}

const { index, titleEs, titleEn } = Astro.props;
---

<div class="mb-8 flex items-center gap-3">
	<span class="font-mono text-2xl text-accent sm:text-3xl" aria-hidden="true">{index}</span>
	<span class="text-text-muted [&>svg]:size-6 sm:[&>svg]:size-7">
		<slot name="icon" />
	</span>
	<h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
		<T es={titleEs} en={titleEn} />
	</h2>
	<span class="h-px flex-1 bg-border"></span>
</div>
