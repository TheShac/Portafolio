---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
import SectionHeader from "./SectionHeader.astro";
import IconFolder from "./icons/IconFolder.astro";
---

<section id="proyectos" class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
	<SectionHeader index="03" titleEs="Proyectos" titleEn="Projects">
		<IconFolder slot="icon" class="size-4.5" />
	</SectionHeader>

	<div class="flex flex-col divide-y divide-border">
		{
			projects.map((project) => (
				<div class="py-10 first:pt-0 last:pb-0">
					<ProjectCard {...project} />
				</div>
			))
		}
	</div>
</section>
